# TEMPLATE. Not a working formula until placeholders are filled (docs/RELEASE.md).
# Fill from SHA256SUMS of the release; publish in a tap repo (@REPO_OWNER@/homebrew-tap, Formula/nemo.rb).
# Name the formula "nemo-acd" if it must coexist with another "nemo" formula.
class Nemo < Formula
  desc "Nemo autonomous coding agent"
  homepage "https://github.com/@REPO@"
  version "@VERSION@"
  license "MIT"

  on_macos do
    on_arm do
      url "https://github.com/@REPO@/releases/download/v@VERSION@/nemo-@VERSION@-aarch64-apple-darwin.tar.gz"
      sha256 "@SHA256_AARCH64_APPLE_DARWIN@"
    end
    on_intel do
      url "https://github.com/@REPO@/releases/download/v@VERSION@/nemo-@VERSION@-x86_64-apple-darwin.tar.gz"
      sha256 "@SHA256_X86_64_APPLE_DARWIN@"
    end
  end
  on_linux do
    on_arm do
      url "https://github.com/@REPO@/releases/download/v@VERSION@/nemo-@VERSION@-aarch64-unknown-linux-gnu.tar.gz"
      sha256 "@SHA256_AARCH64_UNKNOWN_LINUX_GNU@"
    end
    on_intel do
      url "https://github.com/@REPO@/releases/download/v@VERSION@/nemo-@VERSION@-x86_64-unknown-linux-gnu.tar.gz"
      sha256 "@SHA256_X86_64_UNKNOWN_LINUX_GNU@"
    end
  end

  def install
    # Archive root is nemo-<version>-<target>/ (Homebrew strips one level).
    bin.install "nemo"
    bin.install "nemo-sandbox-exec" if OS.linux? # must sit next to nemo (Landlock backend)
  end

  test do
    assert_match "nemo #{version}", shell_output("#{bin}/nemo --version")
  end
end
