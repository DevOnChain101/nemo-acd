# TEMPLATE. Not a working formula until placeholders are filled (docs/RELEASE.md).
# Fill from SHA256SUMS of the release; publish in a tap repo (DevOnChain101/homebrew-tap, Formula/synthesis.rb).
# Name the formula "synthesis-agent" if it must coexist with another "synthesis" formula.
class Synthesis < Formula
  desc "Synthesis autonomous coding agent"
  homepage "https://github.com/DevOnChain101/nemo-acd"
  version "@VERSION@"
  license "Apache-2.0"

  on_macos do
    on_arm do
      url "https://github.com/DevOnChain101/nemo-acd/releases/download/v@VERSION@/synthesis-@VERSION@-aarch64-apple-darwin.tar.gz"
      sha256 "@SHA256_AARCH64_APPLE_DARWIN@"
    end
    on_intel do
      url "https://github.com/DevOnChain101/nemo-acd/releases/download/v@VERSION@/synthesis-@VERSION@-x86_64-apple-darwin.tar.gz"
      sha256 "@SHA256_X86_64_APPLE_DARWIN@"
    end
  end
  on_linux do
    on_arm do
      url "https://github.com/DevOnChain101/nemo-acd/releases/download/v@VERSION@/synthesis-@VERSION@-aarch64-unknown-linux-gnu.tar.gz"
      sha256 "@SHA256_AARCH64_UNKNOWN_LINUX_GNU@"
    end
    on_intel do
      url "https://github.com/DevOnChain101/nemo-acd/releases/download/v@VERSION@/synthesis-@VERSION@-x86_64-unknown-linux-gnu.tar.gz"
      sha256 "@SHA256_X86_64_UNKNOWN_LINUX_GNU@"
    end
  end

  def install
    # Archive root is synthesis-<version>-<target>/ (Homebrew strips one level).
    bin.install "synth"
    bin.install "synthesis-sandbox-exec" if OS.linux? # must sit next to synth (Landlock backend)
  end

  test do
    assert_match "synth #{version}", shell_output("#{bin}/synth --version")
  end
end
