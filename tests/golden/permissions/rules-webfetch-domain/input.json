{
  "autoMode": {},
  "calls": [
    {
      "input": {
        "url": "https://example.com/a"
      },
      "tool": "WebFetch"
    },
    {
      "input": {
        "url": "https://evil.test/a"
      },
      "tool": "WebFetch"
    },
    {
      "input": {
        "url": "https://other.test"
      },
      "tool": "WebFetch"
    }
  ],
  "cwd": "<TMP>/ws",
  "flags": {},
  "fs": {
    "dirs": [
      "<TMP>/ws/sub"
    ]
  },
  "home": "<HOME>",
  "modes": [
    "default",
    "acceptEdits",
    "plan",
    "auto",
    "dontAsk",
    "bypassPermissions"
  ],
  "op": "check",
  "rules": {
    "allow": [
      "WebFetch(domain:example.com)"
    ],
    "deny": [
      "WebFetch(domain:evil.test)"
    ]
  },
  "suggestions": false
}
