{
  "autoMode": {},
  "calls": [
    {
      "input": {
        "command": "rm -rf ~"
      },
      "tool": "Bash"
    },
    {
      "input": {
        "command": "rm -rf <TMP>/ws"
      },
      "tool": "Bash"
    },
    {
      "input": {
        "command": "touch .git/x"
      },
      "tool": "Bash"
    },
    {
      "input": {
        "command": "rm x"
      },
      "tool": "Bash"
    },
    {
      "input": {
        "file_path": "<TMP>/ws/.git/config"
      },
      "tool": "Edit"
    },
    {
      "input": {
        "file_path": "<TMP>/ws/.git/config"
      },
      "tool": "Write"
    }
  ],
  "cwd": "<TMP>/ws",
  "flags": {},
  "fs": {
    "dirs": [
      "<TMP>/ws/sub"
    ]
  },
  "home": "<HOME>",
  "modes": [
    "default",
    "acceptEdits",
    "plan",
    "auto",
    "dontAsk",
    "bypassPermissions"
  ],
  "op": "check",
  "rules": {
    "allow": [
      "Bash(rm:*)",
      "Bash(touch:*)",
      "Edit(.git/**)",
      "Write"
    ]
  },
  "suggestions": false
}
