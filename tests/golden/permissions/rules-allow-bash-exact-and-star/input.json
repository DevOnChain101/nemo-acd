{
  "autoMode": {},
  "calls": [
    {
      "input": {
        "command": "make build"
      },
      "tool": "Bash"
    },
    {
      "input": {
        "command": "make build2"
      },
      "tool": "Bash"
    },
    {
      "input": {
        "command": "echo hello"
      },
      "tool": "Bash"
    },
    {
      "input": {
        "command": "echo a; make clean"
      },
      "tool": "Bash"
    }
  ],
  "cwd": "<TMP>/ws",
  "flags": {},
  "fs": {
    "dirs": [
      "<TMP>/ws/sub"
    ]
  },
  "home": "<HOME>",
  "modes": [
    "default",
    "acceptEdits",
    "plan",
    "auto",
    "dontAsk",
    "bypassPermissions"
  ],
  "op": "check",
  "rules": {
    "allow": [
      "Bash(make build)",
      "Bash(echo *)"
    ]
  },
  "suggestions": false
}
