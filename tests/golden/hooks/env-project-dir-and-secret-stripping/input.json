{
  "config": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "command": "printf '%s|%s|%s|%s' \"$CLAUDE_PROJECT_DIR\" \"$SYNTHESIS_PROJECT_DIR\" \"${SYNTHESIS_API_KEY:-absent}\" \"${SYNTHESIS_ANTHROPIC_API_KEY:-absent}\"",
            "type": "command"
          }
        ],
        "matcher": "*"
      }
    ]
  },
  "event": "UserPromptSubmit",
  "op": "run",
  "opts": {
    "cwd": "<TMP>/ws",
    "env": {
      "SYNTHESIS_ANTHROPIC_API_KEY": "secret",
      "SYNTHESIS_API_KEY": "flat-secret"
    }
  },
  "payload": {
    "prompt": "x"
  },
  "target": null
}
