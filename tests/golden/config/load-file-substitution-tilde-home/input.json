{
  "cwd": "<TMP>/ws",
  "env": {},
  "files": {
    "<HOME>/tok.txt": "tok-home",
    "<SYNTHESIS_HOME>/synthesis.json": {
      "$schema": "config.json/v1",
      "providers": {
        "p": {
          "authToken": "{file:~/tok.txt}",
          "type": "openai"
        }
      }
    }
  },
  "home": "<SYNTHESIS_HOME>",
  "op": "loadConfig"
}
