{
  "cwd": "<TMP>/ws",
  "env": {
    "SYNTHESIS_BASE_URL": "https://other.example.test/v1",
    "SYNTHESIS_PROVIDER": "corp"
  },
  "files": {
    "<SYNTHESIS_HOME>/synthesis.json": {
      "$schema": "config.json/v1",
      "providers": {
        "Corp": {
          "baseURL": "https://c.example.test/v1",
          "type": "openai"
        }
      }
    }
  },
  "home": "<SYNTHESIS_HOME>",
  "op": "loadConfig"
}
