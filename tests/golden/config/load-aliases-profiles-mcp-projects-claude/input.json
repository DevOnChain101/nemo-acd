{
  "cwd": "<TMP>/ws",
  "env": {},
  "files": {
    "<SYNTHESIS_HOME>/synthesis.json": {
      "$schema": "config.json/v1",
      "aliases": {
        "fast": "gateway/m-1"
      },
      "claude": {
        "readUserConfig": false
      },
      "maxTokens": 4096,
      "mcp": {
        "s1": {
          "command": [
            "node",
            "x.js"
          ],
          "enabled": true,
          "environment": {
            "A": "b"
          },
          "type": "local"
        }
      },
      "mcpServers": {
        "s2": {
          "headers": {
            "A": "b"
          },
          "type": "http",
          "url": "https://mcp.example.test"
        }
      },
      "profiles": {
        "deep": [
          "gateway/m-2",
          {
            "model": "gateway/m-1"
          }
        ],
        "fast": {
          "candidates": [
            "gateway/m-1"
          ]
        }
      },
      "projects": {
        "/p": {
          "enableAllProjectMcpServers": true,
          "enabledMcpjsonServers": [
            "a"
          ]
        }
      }
    }
  },
  "home": "<SYNTHESIS_HOME>",
  "op": "loadConfig"
}
