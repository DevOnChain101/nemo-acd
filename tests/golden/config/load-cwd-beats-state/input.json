{
  "cwd": "<TMP>/ws",
  "env": {},
  "files": {
    "<SYNTHESIS_HOME>/synthesis.json": {
      "$schema": "config.json/v1",
      "providers": {
        "gateway": {
          "apiKey": "sk-test-inline",
          "baseURL": "https://gw.example.test/v1",
          "models": [
            "m-1",
            "m-2"
          ],
          "type": "openai"
        }
      }
    },
    "<SYNTHESIS_HOME>/state.json": {
      "model": "gateway/m-2"
    },
    "<TMP>/ws/.synthesis/config.json": {
      "$schema": "config.json/v1",
      "model": "gateway/m-1"
    }
  },
  "home": "<SYNTHESIS_HOME>",
  "op": "loadConfig"
}
