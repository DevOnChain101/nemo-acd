{
  "cwd": "<TMP>/ws",
  "env": {
    "SYNTHESIS_BASE_URL": "https://gw2.example.test/v1",
    "SYNTHESIS_PROVIDER": "gateway"
  },
  "files": {
    "<SYNTHESIS_HOME>/synthesis.json": {
      "$schema": "config.json/v1",
      "model": "anthropic/foo",
      "providers": {
        "gateway": {
          "apiKey": "sk-test-inline",
          "baseURL": "https://gw.example.test/v1",
          "models": [
            "m-1",
            "m-2"
          ],
          "type": "openai"
        }
      }
    }
  },
  "home": "<SYNTHESIS_HOME>",
  "op": "loadConfig"
}
