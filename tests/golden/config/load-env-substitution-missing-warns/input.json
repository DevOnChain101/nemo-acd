{
  "cwd": "<TMP>/ws",
  "env": {},
  "files": {
    "<SYNTHESIS_HOME>/synthesis.json": {
      "$schema": "config.json/v1",
      "providers": {
        "p": {
          "apiKey": "{env:NOPE}",
          "authToken": "{env:NOPE2}",
          "headers": {
            "A": "{env:NOPE3}"
          },
          "type": "openai"
        }
      }
    }
  },
  "home": "<SYNTHESIS_HOME>",
  "op": "loadConfig"
}
