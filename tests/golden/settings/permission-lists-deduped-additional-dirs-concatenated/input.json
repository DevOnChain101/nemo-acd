{
  "cwd": "<TMP>/ws",
  "env": {},
  "files": {
    "<HOME>/.synthesis/settings.json": {
      "permissions": {
        "additionalDirectories": [
          "/a",
          "/b"
        ],
        "allow": [
          "Read",
          "Read",
          "Grep"
        ],
        "ask": [
          "Bash"
        ]
      }
    },
    "<TMP>/ws/.synthesis/settings.json": {
      "permissions": {
        "additionalDirectories": [
          "/b",
          "/c"
        ],
        "allow": [
          "Grep",
          "Glob"
        ],
        "ask": [
          "Bash",
          "Edit"
        ]
      }
    }
  },
  "op": "workspace"
}
