{
  "cwd": "<TMP>/ws",
  "env": {},
  "files": {
    "<HOME>/.claude.json": {
      "mcpServers": {
        "dup": {
          "command": "user"
        }
      }
    },
    "<HOME>/.synthesis/synthesis.json": {
      "claude": {
        "readUserConfig": true
      },
      "mcpServers": {
        "dup": {
          "command": "synthesis-user"
        }
      }
    },
    "<TMP>/ws/.synthesis/config.json": {
      "mcp": {
        "dup": {
          "command": "synthesis-project"
        }
      }
    }
  },
  "op": "workspace"
}
