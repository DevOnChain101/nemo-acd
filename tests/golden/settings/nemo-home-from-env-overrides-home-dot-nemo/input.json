{
  "cwd": "<TMP>/ws",
  "env": {
    "NEMO_HOME": "<NEMO_HOME>"
  },
  "files": {
    "<HOME>/.nemo/settings.json": {
      "permissions": {
        "allow": [
          "DotNemo"
        ]
      }
    },
    "<NEMO_HOME>/settings.json": {
      "permissions": {
        "allow": [
          "FromNemoHome"
        ]
      }
    }
  },
  "op": "workspace"
}
