{
  "cwd": "<TMP>/ws",
  "env": {
    "CLAUDE_CONFIG_DIR": "<TMP>/outside/claude"
  },
  "files": {
    "<HOME>/.claude/settings.json": {
      "permissions": {
        "allow": [
          "HomeClaude"
        ]
      }
    },
    "<HOME>/.synthesis/synthesis.json": {
      "claude": {
        "readUserConfig": true
      }
    },
    "<TMP>/outside/claude/settings.json": {
      "permissions": {
        "allow": [
          "FromEnvDir"
        ]
      }
    }
  },
  "op": "workspace"
}
