{
  "id": "fe-form-validation",
  "version": 1,
  "category": "frontend",
  "fixture": "form-validation",
  "requires": [
    "node>=20"
  ],
  "prompt": "The signup form says \"Enter a valid email address\" for a+b@x.io, which is a valid address. Fix the validation.",
  "acceptance_criteria": [
    {
      "id": "c1",
