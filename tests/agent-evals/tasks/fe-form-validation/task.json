  "setup": [],
  "hidden_checks": [
    {
      "id": "h1",
      "command": "node --test hidden/",
      "timeout_ms": 120000
    }
  ],
  "regression_checks": [
    {
      "id": "r1",
      "command": "node --test test/",
      "timeout_ms": 120000
    }
  ],
  "permission_mode": "acceptEdits",
  "network": "deny",
  "budget": {
    "max_turns": 40,
    "max_tool_calls": 150,
    "max_wall_ms": 900000
  },
